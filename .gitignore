# Python virtual environments
env/
venv/
.env/
flask-project-env/

# Python cache files
__pycache__/
*.pyc
*.pyo
*$py.class

# SQLite and other DB files
*.db
*.sqlite
database.db

# Flask instance folder (usually contains config files)
instance/

# Flask-Migrate migrations folder
migrations/

# IDE/editor folders
.vscode/
.idea/
*.iml
*.ipr
*.iws

# Logs and temp files
*.log
*.tmp

# System files
.DS_Store
Thumbs.db

# PowerShell scripts (if you don't want to track setup scripts)
docs/*.ps1

# Ignore Python egg files
*.egg-info/
dist/
build/
.eggs/
